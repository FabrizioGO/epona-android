    <!-- Help &amp; FAQ -->
    <string name="help_faq_title">Preguntas frecuentes</string>
    <string name="help_contact_title">¿Aún necesitas ayuda?</string>
    <string name="help_contact_desc">Nuestro equipo de soporte está encantado de ayudarte con lo que las preguntas frecuentes no cubrieron.</string>
    <string name="help_email_support">Soporte por email</string>
    <string name="help_email_subject">Solicitud de soporte Epona</string>
    <string name="faq_q1_question">¿Cómo reporto una mascota perdida?</string>
    <string name="faq_q1_answer">Desde la pestaña Home, toca el botón + para crear una nueva alerta, selecciona la mascota, agrega la última ubicación vista y envíala. Los usuarios cercanos serán notificados.</string>
    <string name="faq_q2_question">¿Cómo reporto un avistamiento?</string>
    <string name="faq_q2_answer">Abre el detalle de la alerta y toca «Reportar avistamiento» para compartir la ubicación, una nota y fotos de donde viste a la mascota.</string>
    <string name="faq_q3_question">¿Cómo agrego o edito mis mascotas?</string>
    <string name="faq_q3_answer">Ve a Perfil &gt; Mis Mascotas, luego toca el botón + para agregar una nueva mascota, o toca el icono de editar en una mascota existente para actualizar sus datos.</string>
    <string name="faq_q4_question">¿Cómo resuelvo una alerta cuando aparece la mascota?</string>
    <string name="faq_q4_answer">Abre la alerta desde Mis Alertas o desde el detalle de la alerta y toca «Marcar como resuelto».</string>
    <string name="faq_q5_question">¿Cómo se usa mi ubicación?</string>
    <string name="faq_q5_answer">La ubicación se usa para mostrar alertas cercanas y para registrar dónde se vio la mascota por última vez o dónde fue avistada. Puedes ajustar tu radio de notificación en Configuración.</string>

