    <!-- Help & FAQ -->
    <string name="help_faq_title">Frequently Asked Questions</string>
    <string name="help_contact_title">Still need help?</string>
    <string name="help_contact_desc">Our support team is happy to help with anything the FAQs didn\'t cover.</string>
    <string name="help_email_support">Email Support</string>
    <string name="help_email_subject">Epona Support Request</string>
    <string name="faq_q1_question">How do I report a lost pet?</string>
    <string name="faq_q1_answer">From the Home tab, tap the + button to start a new alert, select the pet, add the last seen location, and submit. Nearby users will be notified.</string>
    <string name="faq_q2_question">How do I report a sighting?</string>
    <string name="faq_q2_answer">Open an alert\'s detail page and tap \"Report Sighting\" to share the location, a note, and photos of where you saw the pet.</string>
    <string name="faq_q3_question">How do I add or edit my pets?</string>
    <string name="faq_q3_answer">Go to Profile &gt; My Pets, then tap the + button to add a new pet, or tap the edit icon on an existing pet to update its details.</string>
    <string name="faq_q4_question">How do I resolve an alert once the pet is found?</string>
    <string name="faq_q4_answer">Open the alert from My Alerts or the alert detail screen and tap \"Mark as Resolved\".</string>
    <string name="faq_q5_question">How is my location used?</string>
    <string name="faq_q5_answer">Location is used to show nearby alerts and to record where a pet was last seen or spotted. You can adjust your notification radius in Settings.</string>

