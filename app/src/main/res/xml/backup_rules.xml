<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower (API 31+ uses data_extraction_rules).
   See https://developer.android.com/guide/topics/data/autobackup

   Nothing is backed up: shared preferences hold the Supabase session (including
   the refresh token), and the Room database is a refetchable cache.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
