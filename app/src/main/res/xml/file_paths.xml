<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        Photos captured by the system camera app through ACTION_IMAGE_CAPTURE.
        This is the only root the app shares: processed JPEGs live in cacheDir/picked_photos,
        which is deliberately absent here so nothing outside the app can reach them.
    -->
    <cache-path
        name="camera_photos"
        path="camera/" />
</paths>
